{
  "name": "dvdworkflow",
  "version": "1.0.0",
  "description": "sistema per la creazione del dvd/usb standalone del campo di competenza bit prepared",
  "main": "index.js",
  "scripts": {
    "build": "npm-run-all --silent --parallel check build:favicon build:html",
    "build:html": "node index.js",
    "build:favicon": "echo \"fav\"",
    "check": "echo \"check\"",
    "debug": "DEBUG=metalsmith* node index.js",
    "start": "npm-run-all --silent check build",
    "clean": "npm-run-all --silent --parallel clean:build clean:dist",
    "clean:build": "rimraf ./build ./src",
    "clean:dist": "rimraf ./dist",
    "dist": "echo \"dist\"",
    "open-mac": "opener file://dist/index.html",
    "open-linux": "xdg-open file://dist/index.html"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "chalk": "^4.1.2",
    "csv-parse": "5.6.0",
    "debug": "^3.2.7",
    "directory-tree": "^2.4.0",
    "fs-extra": "^11.4.0",
    "fs-extra-debug": "^1.0.4",
    "gm": "^1.25.1",
    "handlebars": "^4.7.9",
    "handlebars-helpers": "^0.9.8",
    "handlebars-intl": "^1.1.2",
    "metalsmith": "^2.7.0",
    "metalsmith-ancestry": "^1.12.0",
    "metalsmith-asciidoc": "^1.1.0",
    "metalsmith-assets": "^0.1.0",
    "metalsmith-hbt-md": "^1.0.1",
    "metalsmith-layouts": "^1.8.1",
    "metalsmith-layouts-by-name": "^0.1.4",
    "metalsmith-markdown": "^0.2.2",
    "metalsmith-permalinks": "^0.5.0",
    "metalsmith-relative-links": "^1.8.0",
    "metalsmith-renamer": "^0.3.0",
    "metalsmith-rootpath": "^1.0.4",
    "moment": "^2.30.1",
    "multimatch": "^2.1.0",
    "node-emoji": "^1.11.0",
    "npm-run-all": "^4.0.2",
    "opener": "^1.5.2",
    "rimraf": "^3.0.2",
    "shelljs": "^0.8.5",
    "transliteration": "2.3.5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "keywords": [],
  "author": "Bit Prepared",
  "repository": {
    "type": "git",
    "url": "https://github.com/.....git"
  },
  "bugs": {
    "url": "https://github.com/..../issues"
  },
  "homepage": "https://github.com/....",
  "license": "GPL-3.0"
}
